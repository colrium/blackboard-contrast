{
	"name": "Blackboard Contrast",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"editor.background": "#0C1021",
		"editor.foreground": "#F8F8F8",
		"editorCursor.foreground": "#FFFFFFA6",
		"editorWhitespace.foreground": "#FFFFFF40",
		"editorLineNumber.foreground": "#5C6A94",
		"editorLineNumber.activeForeground": "#F8F8F8",
		"editorRuler.foreground": "#1B2447",
		"editor.lineHighlightBackground": "#FFFFFF0F",
		"editor.lineHighlightBorder": "#00000000",
		"editorLink.activeForeground": "#F8F8F8",
		"editorCodeLens.foreground": "#5C6A94",
		"editorInlayHint.foreground": "#8FA0C8",
		"editorInlayHint.background": "#1B244788",
		"editor.selectionBackground": "#1F4090",
		"editor.selectionForeground": "#FFFFFF",
		"editor.inactiveSelectionBackground": "#1F409066",
		"editor.selectionHighlightBackground": "#1FB89A44",
		"editor.selectionHighlightBorder": "#1FB89A",
		"editor.wordHighlightBackground": "#8A5CF655",
		"editor.wordHighlightBorder": "#8A5CF6",
		"editor.wordHighlightStrongBackground": "#E0489A66",
		"editor.wordHighlightStrongBorder": "#E0489A",
		"editor.findMatchBackground": "#FF6400",
		"editor.findMatchBorder": "#FFD2A8",
		"editor.findMatchHighlightBackground": "#D8FA3C40",
		"editor.findMatchHighlightBorder": "#D8FA3C99",
		"editor.findRangeHighlightBackground": "#FFFFFF14",
		"editor.hoverHighlightBackground": "#72B5FC33",
		"editor.rangeHighlightBackground": "#FFFFFF12",
		"editor.foldBackground": "#FFFFFF0C",
		"editorBracketMatch.background": "#00D1FF33",
		"editorBracketMatch.border": "#00D1FF",
		"editorBracketHighlight.foreground1": "#FBDE2D",
		"editorBracketHighlight.foreground2": "#E0489A",
		"editorBracketHighlight.foreground3": "#72B5FC",
		"editorBracketHighlight.foreground4": "#61CE3C",
		"editorBracketHighlight.foreground5": "#FF6400",
		"editorBracketHighlight.foreground6": "#8A5CF6",
		"editorBracketHighlight.unexpectedBracket.foreground": "#FF5555",
		"editorBracketPairGuide.activeBackground1": "#FBDE2D88",
		"editorBracketPairGuide.activeBackground2": "#E0489A88",
		"editorBracketPairGuide.activeBackground3": "#72B5FC88",
		"editorIndentGuide.background1": "#FFFFFF1A",
		"editorIndentGuide.activeBackground1": "#FFFFFF55",
		"editorError.foreground": "#FF5555",
		"editorWarning.foreground": "#FFB020",
		"editorInfo.foreground": "#72B5FC",
		"editorHint.foreground": "#8FA0C8",
		"editorUnnecessaryCode.opacity": "#00000088",
		"editorGutter.addedBackground": "#61CE3C",
		"editorGutter.modifiedBackground": "#72B5FC",
		"editorGutter.deletedBackground": "#FF5555",
		"editorGutter.background": "#0C1021",
		"editorOverviewRuler.border": "#1B2447",
		"editorOverviewRuler.findMatchForeground": "#FF6400",
		"editorOverviewRuler.selectionHighlightForeground": "#1FB89A",
		"editorOverviewRuler.wordHighlightForeground": "#8A5CF6",
		"editorOverviewRuler.errorForeground": "#FF5555",
		"editorOverviewRuler.warningForeground": "#FFB020",
		"diffEditor.insertedTextBackground": "#61CE3C22",
		"diffEditor.removedTextBackground": "#FF555533",
		"diffEditor.insertedLineBackground": "#61CE3C14",
		"diffEditor.removedLineBackground": "#FF555514",
		"merge.currentHeaderBackground": "#1FB89A66",
		"merge.currentContentBackground": "#1FB89A22",
		"merge.incomingHeaderBackground": "#72B5FC66",
		"merge.incomingContentBackground": "#72B5FC22",
		"merge.commonHeaderBackground": "#8FA0C866",
		"merge.commonContentBackground": "#8FA0C822",
		"minimap.selectionHighlight": "#1F4090",
		"minimap.findMatchHighlight": "#FF6400",
		"minimap.errorHighlight": "#FF5555",
		"minimap.warningHighlight": "#FFB020",
		"searchEditor.findMatchBackground": "#D8FA3C40",
		"searchEditor.findMatchBorder": "#D8FA3C99",
		"editor.stackFrameHighlightBackground": "#FBDE2D33",
		"editor.focusedStackFrameHighlightBackground": "#61CE3C33"
	},
	"semanticTokenColors": {
		"namespace": "#BECDE6",
		"class": "#FF6400",
		"interface": "#FF9A4D",
		"enum": "#FF6400",
		"typeParameter": "#FF9A4D",
		"function": "#BECDE6",
		"method": "#BECDE6",
		"property": "#F8F8F8",
		"variable.readonly": "#D8FA3C",
		"variable.defaultLibrary": "#8DA6CE",
		"parameter": {
			"foreground": "#F8F8F8",
			"italic": true
		},
		"*.deprecated": {
			"strikethrough": true
		}
	},
	"tokenColors": [
		{
			"scope": "comment",
			"settings": {
				"foreground": "#AEAEAE"
			}
		},
		{
			"scope": "constant",
			"settings": {
				"foreground": "#D8FA3C"
			}
		},
		{
			"scope": "entity",
			"settings": {
				"foreground": "#FF6400"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#FBDE2D"
			}
		},
		{
			"scope": "storage",
			"settings": {
				"foreground": "#FBDE2D"
			}
		},
		{
			"scope": ["string", "meta.verbatim"],
			"settings": {
				"foreground": "#61CE3C"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#8DA6CE"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#AB2A1D"
			}
		},
		{
			"scope": "invalid.illegal",
			"settings": {
				"foreground": "#F8F8F8",
				"background": "#9D1E15"
			}
		},
		{
			"scope": "entity.other.inherited-class",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#FF6400"
			}
		},
		{
			"scope": "string constant.other.placeholder",
			"settings": {
				"foreground": "#FF6400"
			}
		},
		{
			"scope": "meta.function-call.py",
			"settings": {
				"foreground": "#BECDE6"
			}
		},
		{
			"scope": ["meta.tag", "meta.tag entity"],
			"settings": {
				"foreground": "#7F90AA"
			}
		},
		{
			"scope": "entity.name.section",
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"scope": "keyword.type.variant",
			"settings": {
				"foreground": "#D5E0F3"
			}
		},
		{
			"scope": "source.ocaml keyword.operator.symbol",
			"settings": {
				"foreground": "#F8F8F8"
			}
		},
		{
			"scope": ["source.ocaml keyword.operator.symbol.infix", "source.ocaml keyword.operator.symbol.prefix"],
			"settings": {
				"foreground": "#8DA6CE"
			}
		},
		{
			"scope": [
				"source.ocaml keyword.operator.symbol.infix.floating-point",
				"source.ocaml keyword.operator.symbol.prefix.floating-point",
				"source.ocaml constant.numeric.floating-point"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "text.tex.latex support.function",
			"settings": {
				"foreground": "#FBDE2D"
			}
		},
		{
			"scope": ["source.plist string.unquoted", "source.plist keyword.operator"],
			"settings": {
				"foreground": "#FFFFFF"
			}
		}
	]
}
